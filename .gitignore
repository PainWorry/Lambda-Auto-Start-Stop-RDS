# ==============================================================================
# AWS CloudOps & Cost Governance Suite - Git Ignore Rules
# ==============================================================================

# Local .terraform directories
**/.terraform/*

# .tfstate files (CRITICAL: Never commit state files containing secrets/IPs)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Plan files (contain unencrypted sensitive values and ephemeral state)
*.tfplan
tfplan

# Crash log files
crash.log
crash.*.log

# Exclude sensitive tfvars files that may contain passwords or account IDs
*.tfvars
!terraform.tfvars.example

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Python cache & virtual environment
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# OS and Editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Credentials, keys & local env files
*.pem
*.key
.env
*.local

# Temporary CLI outputs and build archives
response.json
*.zip

